# 监听
BIND=127.0.0.1
PORT=8791

# 数据目录（data.json + requests.jsonl）
DATA_DIR=data

# 上游 OpenAI 兼容网关
MEOO_AI_BASE=https://api.meoo.host/meoo-ai/compatible-mode/v1

# 富元数据目录站点：用项目 AK 读 /api/v1/agent/models，给已上架模型补
# context_window / max_tokens / multimodal / label。只补字段，不扩模型集合。
# MEOO_METADATA=off 可关闭。
MEOO_WEB_BASE=https://meoo.com
MEOO_METADATA=on

# 目录自动刷新周期（秒），默认 300，最短 30
# MEOO_CATALOG_REFRESH_SEC=300

# 可选：首启预置一个项目 AK（meoo_project_…）
# MEOO_PROJECT_AK=

# 可选：首启预置客户端密钥，逗号分隔
# MEOO2API_KEYS=sk-aaa,sk-bbb

# 时区
TZ=Asia/Shanghai
